# ─── LLM ────────────────────────────────────────────────────────────────────
# Groq API keys — add as many as needed (round-robin rotation, 429 auto-failover)
GROQ_API_KEY_1=gsk_your_first_key_here
GROQ_API_KEY_2=gsk_your_second_key_here

# Model to use (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# ─── GitHub ──────────────────────────────────────────────────────────────────
# Personal access token (needs repo + issues scopes)
GITHUB_TOKEN=ghp_your_token_here

# Default owner/repo for template ${} interpolation
GITHUB_OWNER=samrat-dt
GITHUB_REPO=conversational-ops

# ─── Slack ───────────────────────────────────────────────────────────────────
# Bot token (xoxb-...)  — from OAuth & Permissions page
SLACK_BOT_TOKEN=xoxb-your-bot-token

# App-level token (xapp-...) — from "App-Level Tokens" (needs connections:write scope)
SLACK_APP_TOKEN=xapp-your-app-token

# Optional: override channel → template mapping
# Format: channel-name:template-name,channel-name:template-name
# Default: sales-ops:sales, hiring-ops:hiring, cs-ops:customer-success, investor-ops:investor, partnerships-ops:partnership
# CHANNEL_MAP=sales-ops:sales,hiring-ops:hiring,cs-ops:customer-success

# ─── Server ──────────────────────────────────────────────────────────────────
# Port for the Express API (Railway sets this automatically)
PORT=3001

# Allowed origin for CORS (set to your Vercel web URL)
# WEB_ORIGIN=https://your-app.vercel.app
