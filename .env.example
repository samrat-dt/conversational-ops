# Groq API keys — add as many as needed (GROQ_API_KEY_1 through GROQ_API_KEY_N)
# Keys are rotated round-robin; on 429 errors the next key is tried automatically
GROQ_API_KEY_1=gsk_your_first_key_here
GROQ_API_KEY_2=gsk_your_second_key_here

# GitHub personal access token (needs repo + issues scopes)
GITHUB_TOKEN=ghp_your_token_here

# Default GitHub owner and repo (can be overridden in YAML config)
GITHUB_OWNER=samrat-dt
GITHUB_REPO=conversational-ops

# Groq model to use (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
